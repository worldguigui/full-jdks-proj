    <!-- 11 种货物的基准价 / 目标库存 / 价格弹性 -->
    <resources>
        <resource name="fuel" basePrice="3" target="150" elasticity="1.0"/>
        <resource name="energy" basePrice="2" target="180" elasticity="0.9"/>
        <resource name="food" basePrice="2" target="220" elasticity="0.8"/>
        <resource name="water" basePrice="1" target="200" elasticity="0.9"/>
        <resource name="ore" basePrice="3" target="140" elasticity="1.0"/>
        <resource name="metal" basePrice="6" target="100" elasticity="1.1"/>
        <resource name="material" basePrice="9" target="80" elasticity="1.1"/>
        <resource name="equipment" basePrice="16" target="60" elasticity="1.2"/>
        <resource name="medicine" basePrice="12" target="50" elasticity="1.0"/>
        <resource name="luxury" basePrice="20" target="40" elasticity="1.3"/>
        <resource name="research" basePrice="25" target="30" elasticity="1.2"/>
    </resources>

    <!--
        配方：启动时一次性扣输入，ticks 天后产出入库。
        输入不足则无法开工——补给线必须把原料运到生产设施。
    -->
    <recipes>
        <recipe id="smelt" name="冶炼金属" ticks="3" at="8">
            <in resource="ore" amount="2"/>
            <in resource="fuel" amount="1"/>
            <out resource="metal" amount="2"/>
        </recipe>
        <recipe id="farm" name="农业耕作" ticks="2" at="15">
            <in resource="fuel" amount="1"/>
            <in resource="water" amount="2"/>
            <out resource="food" amount="5"/>
        </recipe>
        <recipe id="refine" name="精炼燃料" ticks="3" at="11">
            <in resource="ore" amount="1"/>
            <out resource="fuel" amount="2"/>
        </recipe>
        <recipe id="pack" name="加工材料" ticks="2" at="3">
            <in resource="metal" amount="2"/>
            <in resource="energy" amount="1"/>
            <out resource="material" amount="2"/>
        </recipe>
        <recipe id="fabricate" name="制造设备" ticks="4" at="9">
            <in resource="metal" amount="2"/>
            <in resource="material" amount="1"/>
            <out resource="equipment" amount="1"/>
        </recipe>
        <recipe id="distill" name="净水与能源" ticks="2" at="3">
            <in resource="energy" amount="1"/>
            <out resource="water" amount="4"/>
        </recipe>
        <recipe id="remedy" name="合成药品" ticks="3" at="14">
            <in resource="water" amount="2"/>
            <in resource="material" amount="1"/>
            <out resource="medicine" amount="1"/>
        </recipe>
        <recipe id="study" name="异常点研究" ticks="4" at="12">
            <in resource="equipment" amount="1"/>
            <in resource="energy" amount="2"/>
            <out resource="research" amount="1"/>
        </recipe>
    </recipes>

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>fc</groupId>
    <artifactId>frontier-chronicle</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Frontier Chronicle</name>
    <description>Full JDK 21 Project - 基于 Java SE 21 的可扩展星际模拟与联机管理平台</description>

    <modules>
        <module>fc-world</module>
        <module>fc-config</module>
        <module>fc-sim</module>
        <module>fc-fleet</module>
        <module>fc-colony</module>
        <module>fc-economy</module>
        <module>fc-science</module>
        <module>fc-diplomacy</module>
        <module>fc-history</module>
        <module>fc-cli</module>
        <module>fc-persist</module>
        <module>fc-extensions</module>
        <module>fc-testkit</module>
        <module>fc-runtime</module>
        <module>fc-audit</module>
    </modules>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>fc</groupId>
                <artifactId>fc-world</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>fc</groupId>
                <artifactId>fc-config</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>fc</groupId>
                <artifactId>fc-sim</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>fc</groupId>
                <artifactId>fc-fleet</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>fc</groupId>
                <artifactId>fc-colony</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>fc</groupId>
                <artifactId>fc-economy</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>fc</groupId>
                <artifactId>fc-science</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>fc</groupId>
                <artifactId>fc-diplomacy</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>fc</groupId>
                <artifactId>fc-history</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>fc</groupId>
                <artifactId>fc-cli</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>fc</groupId>
                <artifactId>fc-persist</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>fc</groupId>
                <artifactId>fc-extensions</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>fc</groupId>
                <artifactId>fc-audit</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>fc</groupId>
                <artifactId>fc-testkit</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>fc</groupId>
                <artifactId>fc-runtime</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <release>21</release>
                        <encoding>UTF-8</encoding>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>3.6.3</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>

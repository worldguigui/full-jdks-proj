<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>fc</groupId>
        <artifactId>frontier-chronicle</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>fc-runtime</artifactId>

    <build>
        <finalName>frontier-chronicle</finalName>
        <plugins>
            <!-- 打成可直接运行的单文件 jar：java -jar frontier-chronicle.jar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.3</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>fc.runtime.Main</mainClass>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>run-runtime-smoke</id>
                        <phase>test</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <classpathScope>test</classpathScope>
                            <arguments>
                                <argument>-ea</argument>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>fc.runtime.RuntimeSmokeTest</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>fc</groupId>
            <artifactId>fc-testkit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>fc</groupId>
            <artifactId>fc-world</artifactId>
        </dependency>
        <dependency>
            <groupId>fc</groupId>
            <artifactId>fc-config</artifactId>
        </dependency>
        <dependency>
            <groupId>fc</groupId>
            <artifactId>fc-sim</artifactId>
        </dependency>
        <dependency>
            <groupId>fc</groupId>
            <artifactId>fc-fleet</artifactId>
        </dependency>
        <dependency>
            <groupId>fc</groupId>
            <artifactId>fc-colony</artifactId>
        </dependency>
        <dependency>
            <groupId>fc</groupId>
            <artifactId>fc-economy</artifactId>
        </dependency>
        <dependency>
            <groupId>fc</groupId>
            <artifactId>fc-science</artifactId>
        </dependency>
        <dependency>
            <groupId>fc</groupId>
            <artifactId>fc-diplomacy</artifactId>
        </dependency>
        <dependency>
            <groupId>fc</groupId>
            <artifactId>fc-history</artifactId>
        </dependency>
        <dependency>
            <groupId>fc</groupId>
            <artifactId>fc-cli</artifactId>
        </dependency>
        <dependency>
            <groupId>fc</groupId>
            <artifactId>fc-persist</artifactId>
        </dependency>
        <dependency>
            <groupId>fc</groupId>
            <artifactId>fc-extensions</artifactId>
        </dependency>
    </dependencies>
</project>

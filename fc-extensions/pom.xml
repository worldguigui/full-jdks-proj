                                <argument>-Djava.awt.headless=true</argument>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>fc.extensions.FcNamingTest</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>run-trust-authority-tests</id>

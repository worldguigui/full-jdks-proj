                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <classpathScope>test</classpathScope>
                            <arguments>
                                <argument>-ea</argument>
                                <argument>-Djava.awt.headless=true</argument>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>fc.extensions.ChatRelayTest</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>run-soundtrack-tests</id>
                        <phase>test</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>

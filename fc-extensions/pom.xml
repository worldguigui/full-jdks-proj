                                <argument>-Djava.awt.headless=true</argument>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>fc.extensions.TelemetryMBeansTest</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>run-fc-naming-tests</id>
